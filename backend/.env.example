# Groq (required — free key at console.groq.com)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAG tuning
SIMILARITY_THRESHOLD=0.15
TOP_K_RESULTS=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# App
APP_NAME=Dwight
DEBUG=false
ENVIRONMENT=production
